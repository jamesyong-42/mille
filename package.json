{
  "name": "mille-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo root for mille — high-performance native primitives for Electron IDEs.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:napi": "pnpm --filter @mille/file-explorer build:napi",
    "test": "pnpm -r --if-present test",
    "bench": "echo \"TODO: criterion + NAPI round-trip bench harness\"",
    "lint": "pnpm -r --if-present lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0",
    "@types/node": "^25.8.0",
    "prettier": "^3.3.0",
    "typescript": "~5.6.0"
  }
}
