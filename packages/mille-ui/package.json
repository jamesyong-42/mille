{
  "name": "@vibecook/mille-ui",
  "version": "0.2.1",
  "description": "React file-tree UI companion to @vibecook/mille. Virtualized, accessible, VS Code File Icon Theme compatible.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/jamesyong-42/mille"
  },
  "homepage": "https://github.com/jamesyong-42/mille#readme",
  "bugs": {
    "url": "https://github.com/jamesyong-42/mille/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js"
    },
    "./commands": {
      "types": "./dist/commands.d.ts",
      "import": "./dist/commands.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js"
    },
    "./icons/default": {
      "types": "./dist/icons-default.d.ts",
      "import": "./dist/icons-default.js"
    },
    "./icons/duotone": {
      "types": "./dist/icons-duotone.d.ts",
      "import": "./dist/icons-duotone.js"
    },
    "./icons/material": {
      "types": "./dist/icons-material.d.ts",
      "import": "./dist/icons-material.js"
    },
    "./icons/minimal": {
      "types": "./dist/icons-minimal.d.ts",
      "import": "./dist/icons-minimal.js"
    },
    "./theme/minimal.css": "./dist/theme/minimal.css",
    "./git": {
      "types": "./dist/git.d.ts",
      "import": "./dist/git.js"
    },
    "./git/node": {
      "types": "./dist/git-node.d.ts",
      "import": "./dist/git-node.js"
    },
    "./agent-rules": {
      "types": "./dist/agent-rules.d.ts",
      "import": "./dist/agent-rules.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./tailwind-preset": {
      "default": "./dist/tailwind-preset.js"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "files": [
    "dist",
    "tokens.css",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --build && node -e \"const fs=require('fs');const tokens=fs.readFileSync('src/theme/tokens.css','utf8');const focus=fs.readFileSync('src/theme/focus.css','utf8');const combined=tokens+'\\n'+focus;fs.mkdirSync('dist',{recursive:true});fs.writeFileSync('dist/tokens.css',combined);fs.writeFileSync('tokens.css',combined);fs.mkdirSync('dist/theme',{recursive:true});fs.copyFileSync('src/theme/minimal.css','dist/theme/minimal.css')\"",
    "build:material": "node scripts/build-material.mjs",
    "prepublishOnly": "node scripts/build-material.mjs && pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "bench": "node bench/scroll-expand.mjs",
    "bench:navigation": "node bench/navigation-state.mjs",
    "bench:active-policy": "node bench/active-entry-policy.mjs"
  },
  "size-limit": [
    {
      "name": "headless (SPEC \u00a712 target; 14 KB ratchet from the 13.84 KB Phase-3 baseline)",
      "path": "dist/headless.js",
      "limit": "14 KB",
      "gzip": true,
      "ignore": [
        "react",
        "react-dom",
        "@vibecook/mille",
        "@tanstack/react-virtual",
        "@radix-ui/react-context-menu",
        "@radix-ui/react-dialog",
        "@radix-ui/react-tooltip"
      ]
    },
    {
      "name": "index (SPEC \u00a712 target 45 KB, limit 75 KB)",
      "path": "dist/index.js",
      "limit": "75 KB",
      "gzip": true,
      "ignore": [
        "react",
        "react-dom",
        "@vibecook/mille",
        "@tanstack/react-virtual",
        "@radix-ui/react-context-menu",
        "@radix-ui/react-dialog",
        "@radix-ui/react-tooltip"
      ]
    }
  ],
  "peerDependencies": {
    "@radix-ui/react-context-menu": "^2.0.0",
    "@radix-ui/react-dialog": "^1.0.0",
    "@radix-ui/react-tooltip": "^1.0.0",
    "@tanstack/react-virtual": "^3.0.0",
    "@vibecook/mille": "workspace:^",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "@radix-ui/react-context-menu": {
      "optional": true
    },
    "@radix-ui/react-dialog": {
      "optional": true
    },
    "@radix-ui/react-tooltip": {
      "optional": true
    }
  },
  "devDependencies": {
    "@radix-ui/react-context-menu": "^2.0.0",
    "@radix-ui/react-dialog": "^1.0.0",
    "@radix-ui/react-tooltip": "^1.0.0",
    "@size-limit/preset-small-lib": "^11.0.0",
    "@tanstack/react-virtual": "^3.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "happy-dom": "^15.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "size-limit": "^11.0.0",
    "tslib": "^2.8.1",
    "typescript": "~6.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
